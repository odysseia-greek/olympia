# Homeros GraphQL HTTP client requests.
# Switch endpoint by changing @host to {{productionHost}} or {{hellasHost}}.

@productionHost = https://odysseia-greek.com/graphql
@localHost = http://byzantion.odysseia-greek:4900/graphql
@hellasHost = http://hellas.odysseia-greek:4900/graphql
@host = {{localHost}}
@requestId = homeros-http-client
@chapter = chapter-02
@chapterText = john-1-1
# Stable UUID, matching the boule value created by Pheidias quiz mode.
@sessionId = 6fb24c4c-e001-4f78-a530-1335e0fc350c

### Health
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Health { health { healthy time version services { name healthy version databaseInfo { healthy clusterName serverName serverVersion } } } }"
}

### Herodotos service health
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query HerodotosHealth { herodotosHealth { healthy time version } corpusHealth { healthy time version } }"
}

### Herodotos corpus options
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query CorpusOptions { corpusOptions { authors { name books { name references { name sections } } } } }"
}

### Analyze root word with Dionysios Research
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Analyze($rootword: String) { analyze(rootword: $rootword) { rootword conjugations { rule word } texts { author book reference referenceLink text { greek section translations } } } }",
  "variables": {
    "rootword": "λόγος"
  }
}

### Check grammar with Dionysios
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Grammar($word: String, $includeAudit: Boolean) { grammar(word: $word, includeAudit: $includeAudit) { results { rootWord rule translations word } audit { requestId word outcome source reason events { step status reason source rule rootWord searchTerm resultCount candidateCount details } } } }",
  "variables": {
    "word": "λόγου",
    "includeAudit": true
  }
}

### Analyze a sentence with Dionysios TextMode
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}
boule: {{sessionId}}

{
  "query": "query Sentence($text: String!, $includeAudit: Boolean) { sentence(text: $text, includeAudit: $includeAudit) { sessionId originalText literalTranslation rateLimit { upstreamIp windowSeconds nextAllowedTime } tokens { token position gloss resolved message results { rootWord rule translations word } } textSearch { searched found status message matchCount query matches { author book reference referenceLink text { greek section translations } } } } }",
  "variables": {
    "text": "μήτε ἔργα μεγάλα τε καὶ θωμαστά, τὰ μὲν Ἕλλησι τὰ δὲ βαρβάροισι ἀποδεχθέντα, ἀκλεᾶ γένηται",
    "includeAudit": false
  }
}

### Dictionary metadata from Alexandros
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query DictionaryMeta { dictionaryMeta { totalRecords updatedRecords legacyRecords } }"
}

### Random extended words from Alexandros
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query RandomExtendedWords($amount: Int) { randomExtendedWords(amount: $amount) { greek } }",
  "variables": {
    "amount": 10
  }
}

### Herodotos chapter options
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query ChapterOptions { chapterOptions { chapters { chapter title order level } } }"
}

### Herodotos chapter
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Chapter($chapter: String!) { chapter(chapter: $chapter) { chapter title description context order level grammar { grammar title explanation example { greek translation note } } vocabulary { greek translation } texts { text title type greek readingHints source { author work reference dialect } } } }",
  "variables": {
    "chapter": "{{chapter}}"
  }
}

### Check a Herodotos chapter answer
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query CheckChapter($input: CheckChapterInput!) { checkChapter(input: $input) { chapter texts { text sourceText actualText learnerText } } }",
  "variables": {
    "input": {
      "chapter": "{{chapter}}",
      "answers": [
        {
          "text": "{{chapterText}}",
          "learnerText": "In the beginning was the Word"
        }
      ]
    }
  }
}

### Retrieve a complete corpus text
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query CorpusText($input: TextInput!) { corpusText(input: $input) { author book type reference perseusTextLink passages { section greek translations } } }",
  "variables": {
    "input": {
      "author": "Herodotos",
      "book": "Histories",
      "reference": "1.1"
    }
  }
}

### Retrieve one corpus section
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query CorpusSection($input: TextInput!) { corpusText(input: $input) { author book type reference perseusTextLink passages { section greek translations } } }",
  "variables": {
    "input": {
      "author": "Herodotos",
      "book": "Histories",
      "reference": "1.1",
      "section": "a"
    }
  }
}

### Check a corpus translation
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query CheckText($input: CheckTextInput!) { checkText(input: $input) { averageLevenshteinPercentage sections { section levenshteinPercentage quizSentence answerSentence } possibleTypos { source provided } } }",
  "variables": {
    "input": {
      "author": "Herodotos",
      "book": "Histories",
      "reference": "1.1",
      "translations": [
        {
          "section": "a",
          "translation": "This is a sentence"
        }
      ]
    }
  }
}

### Exact lexicon search
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Exact($input: ExpandableSearchQueryInput!) { exact(input: $input) { results { id headword normalized linkedWord partOfSpeech article gender quickGlosses { language gloss } definitions { grade meanings { language definition notes example } } modernConnections { term note } } pageInfo { page size total } similarWords { greek original linkedWord english dutch } foundInText { rootword texts { author book reference text { greek section translations } } } } }",
  "variables": {
    "input": {
      "word": "λογος",
      "language": "LANG_GREEK",
      "expand": true,
      "page": 1,
      "size": 10
    }
  }
}

### Fuzzy lexicon search
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query Fuzzy($input: SearchQueryInput!) { fuzzy(input: $input) { results { id headword normalized linkedWord partOfSpeech article gender quickGlosses { language gloss } definitions { grade meanings { language definition notes example } } modernConnections { term note } } pageInfo { page size total } } }",
  "variables": {
    "input": {
      "word": "λογος",
      "language": "LANG_GREEK",
      "page": 1,
      "size": 10
    }
  }
}

### Quiz options
POST {{host}}
Content-Type: application/json
X-Request-ID: {{requestId}}

{
  "query": "query QuizOptions { mediaOptions { themes { name segments { name maxSet } } } multipleChoiceOptions { themes { name maxSet } } authorBasedOptions { themes { name segments { name maxSet } } } dialogueOptions { themes { name maxSet } } grammarOptions { themes { name segments { name difficulty maxSet } } } journeyOptions { themes { name segments { name number location coordinates { x y } } } } }"
}
