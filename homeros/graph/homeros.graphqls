type AggregateResult {
  themes: [Themes]
}

type AggregationResult {
  authors: [ESAuthor]
}

type AnswerSection {
  answerSentence: String
  levenshteinPercentage: String
  quizSentence: String
  section: String
}

input CheckTextRequestInput {
  translations: [TranslationsInput]
  author: String
  book: String
  reference: String
}

type CheckTextResponse {
  averageLevenshteinPercentage: String
  possibleTypos: [Typo]
  sections: [AnswerSection]
}

input CreateTextInput {
  author: String
  book: String
  reference: String
  section: String
}

type Database {
  clusterName: String
  healthy: Boolean
  serverName: String
  serverVersion: String
}

type ESAuthor {
  books: [ESBook]
  key: String
}

type ESBook {
  key: String
  references: [Reference]
}

type Health {
  database: Database
  healthy: Boolean
  time: String
}

type Reference {
  key: String
  sections: [Section]
}

type DeclensionTranslationResult {
  results: [Result]
  audit: GrammarAudit
}
type Result {
  rootWord: String
  rule: String
  translations: [String]
  word: String
}

type GrammarAudit {
  requestId: String!
  word: String!
  outcome: String!
  source: String!
  reason: String!
  events: [GrammarAuditEvent!]!
}

type GrammarAuditEvent {
  step: String!
  status: String!
  reason: String!
  source: String!
  rule: String!
  rootWord: String!
  searchTerm: String!
  resultCount: Int!
  candidateCount: Int!
  details: [String!]!
}

type DionysiosRateLimit {
  upstreamIp: String!
  windowSeconds: Int!
  nextAllowedTime: String!
}

type DionysiosTextToken {
  token: String!
  position: Int!
  results: [Result!]!
  gloss: String!
  resolved: Boolean!
  message: String!
}

type DionysiosTextSearch {
  searched: Boolean!
  found: Boolean!
  status: String!
  message: String!
  matchCount: Int!
  query: String!
  matches: [AnalyzeResult!]!
}

type DionysiosSentenceResponse {
  sessionId: String!
  originalText: String!
  literalTranslation: String!
  rateLimit: DionysiosRateLimit
  tokens: [DionysiosTextToken!]!
  textSearch: DionysiosTextSearch
}

extend type Query {
  analyze(rootword: String): AnalyzeTextResponse
  check(input: CheckTextRequestInput): CheckTextResponse
  create(input: CreateTextInput): Text
  grammar(word: String, includeAudit: Boolean = false): DeclensionTranslationResult
  sentence(text: String!, includeAudit: Boolean = false): DionysiosSentenceResponse!
  status: Status
  textOptions: AggregationResult
}

type Section {
  key: String
}

type Segments {
  maxSet: Int
  name: String
}

"""The way to check whether backend apis are available"""
type Status {
  dionysios: Health
  herodotos: Health
  overallHealth: Boolean
}

type Text {
  author: String
  book: String
  perseusTextLink: String
  reference: String
  rhemai: [Rhema]
  type: String
}

type Themes {
  name: String
  segments: [Segments]
}

input TranslationsInput {
  section: String
  translation: String
}

type Typo {
  provided: String
  source: String
}
